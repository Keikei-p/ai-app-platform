# Ivy / Aivy environment example
# Copy values into your runtime environment. Never commit real credentials.

# Optional external AI credentials
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama
AIVY_OLLAMA_URL=http://127.0.0.1:11434
AIVY_OLLAMA_MODEL=qwen2.5:7b

# Optional source / cloud connectors
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
SUPABASE_KEY=

# Optional secure cloud runtime
AI_APP_PLATFORM_STATE_DIR=
AI_APP_ENABLE_REMOTE=0
AI_APP_LOCAL_API_TOKEN=

# Optional distribution/updater source owned by the distributor or buyer
AIVY_UPSTREAM_REPO=

# AI COMPANY OS bridge: disabled unless this token is at least 32 chars.
# Match AI_COMPANY_IVY_BRIDGE_TOKEN on the AI COMPANY OS PC process.
# Do not commit a real token or expose the bridge over LAN/the internet.
AIVY_COMPANY_BRIDGE_TOKEN=
