{
  "name": "ivy-mobile-intake-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "ACCESS_AUD": "REPLACE_WITH_CLOUDFLARE_ACCESS_AUD",
    "TEAM_DOMAIN": "https://REPLACE-ME.cloudflareaccess.com",
    "OWNER_EMAIL": "replace-with-owner@example.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ivy-mobile-intake-staging",
      "database_id": "REPLACE_WITH_NEW_STAGING_DB_ID", "migrations_dir": "./migrations" }
  ]
}
